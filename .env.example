# ============================================================================
# AETHERIA ACADEMY LMS - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env (and server/.env) and replace placeholder values
# before deploying to production. Never commit real secrets to version control.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
# Supported DB_DIALECT values: sqlite (local zero-config default) | mysql (MySQL 8 production & Docker)
# Note: docker-compose.yml automatically sets DB_DIALECT=mysql inside containers.
DB_DIALECT=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms_production
DB_USER=lms_user
DB_PASSWORD=replace_with_secure_db_password
DB_STORAGE=./data/lms_database.sqlite

# Session & Authentication Security
SESSION_SECRET=replace_with_at_least_64_char_cryptographic_random_secret_string
SESSION_NAME=lms.sid
SESSION_MAX_AGE_MS=28800000
CSRF_ENABLED=false

# Initial Bootstrap Administrator (Used only during explicit bootstrap/seed)
BOOTSTRAP_ADMIN_EMAIL=superadmin@academy.edu
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# File Upload Storage Configuration
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=52428800

# Email / SMTP Notification Configuration (Optional Integration)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.edu
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Aetheria Academy LMS <no-reply@academy.edu>"

# Logging
LOG_LEVEL=info
